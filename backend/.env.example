PORT=5000
JWT_SECRET=your_jwt_secret_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP Email Verification Settings
# For Gmail: Use smtp.gmail.com, Port 587, and an App Password from Google Account Security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_app_password_here
SMTP_FROM="CampusGig Verification <noreply@campusgig.edu>"

# ─── Twilio SMS OTP (for Phone Number Verification) ──────────────────────────
# Sign up at https://www.twilio.com and get these from your Console Dashboard
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Your Twilio phone number in E.164 format, e.g. +14155552671
TWILIO_PHONE_NUMBER=your-twilio-phone-number
